# Keep DRY_RUN=true until you have tested the strategy carefully.
DRY_RUN=true

# Delta India production:
DELTA_BASE_URL=https://api.india.delta.exchange
DELTA_PUBLIC_WS_URL=wss://public-socket.india.delta.exchange
DELTA_PRIVATE_WS_URL=wss://socket.india.delta.exchange

# Required only when DRY_RUN=false.
DELTA_API_KEY=
DELTA_API_SECRET=

# Strategy
UNDERLYING=BTC
QUOTE_CURRENCY=USD
ENTRY_TIME=09:30
TIMEZONE=Asia/Kolkata
EXPIRY_RANK=1
# Use 24-hour time. For BTC 5:30 PM, use 17:30.
EXPIRY_CUTOFF_TIME=17:30
CALL_DELTA=0.10
PUT_DELTA=-0.10
TARGET_MAX_PROFIT_USD=100

# Position sizing. Delta order size is generally an integer contract count.
QUANTITY_STEP=1
MIN_QUANTITY=1
USE_CONTRACT_VALUE_MULTIPLIER=true

# Execution
POLL_INTERVAL_SECONDS=1
ORDER_CONFIRM_TIMEOUT_SECONDS=20
ORDER_RETRY_SECONDS=2
ENTRY_ORDER_TYPE=market_order
HEDGE_ORDER_TYPE=market_order

# State and logging
STATE_DB_PATH=data/bot_state.sqlite3
LOG_LEVEL=INFO

